DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"
BETTER_AUTH_SECRET="generate: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
BETTER_AUTH_URL="https://your-domain.com"
APP_URL="https://your-domain.com"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="no-reply@your-domain.com"
SMTP_PASS=""
MAIL_FROM="MyGST <no-reply@your-domain.com>"
SUPER_ADMIN_EMAILS="you@your-domain.com"

# ── Backups to Google Drive ──
# Google Cloud Console → APIs & Services: enable "Google Drive API"; create OAuth client ID (Web application)
# with authorized redirect URI: https://your-domain.com/api/backup/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Encrypts stored Drive tokens (generate like BETTER_AUTH_SECRET). Changing it requires reconnecting Drive.
BACKUP_ENCRYPTION_KEY=""
# Secret for the cron URL (/api/cron/backup). Generate like BETTER_AUTH_SECRET.
CRON_SECRET=""
# Optional built-in 15-minute scheduler (opt-in). Keep "false" on Hostinger and use a Cron Job (see README).
BACKUP_INTERNAL_SCHEDULER="false"
