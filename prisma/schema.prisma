generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────── Auth (Better Auth core tables) ─────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?  @db.Text
  /// Disabled by a platform admin: can't sign in, sessions are dropped.
  disabledAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  platformRoles PlatformRoleAssignment[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────── Tenancy ─────────────────────────

model Company {
  id               String    @id @default(cuid())
  legalName        String
  tradeName        String    @default("")
  gstin            String    @default("")
  address          String    @default("") @db.VarChar(500)
  city             String    @default("")
  pincode          String    @default("")
  stateCode        String    @db.Char(2)
  phone            String    @default("")
  email            String    @default("")
  logo             Bytes?    @db.MediumBlob
  logoMime         String?
  bankName         String    @default("")
  bankAccount      String    @default("")
  bankIfsc         String    @default("")
  bankBranch       String    @default("")
  upiId            String    @default("")
  terms            String?   @db.Text
  pricesIncludeTax Boolean   @default(false)
  /// Books are locked (closed financial years) up to and including this date.
  lockedUntil      DateTime? @db.Date
  /// Set when the owner finishes the setup wizard.
  setupCompletedAt DateTime?
  /// Suspended by a platform super-admin: members can't open the company.
  suspendedAt      DateTime?
  /// "SIGNUP" (self-service) or "ADMIN" (created from the super-admin panel).
  createdVia       String    @default("SIGNUP")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships   Membership[]
  invitations   Invitation[]
  roles         CompanyRole[]
  parties       Party[]
  products      Product[]
  numberSeries  NumberSeries[]
  documents     Document[]
  purchases     PurchaseBill[]
  payments      Payment[]
  auditLogs     AuditLog[]
  backupTargets BackupTarget[]
  apiKeys       ApiKey[]
  integration   CompanyIntegration?
  outboxEvents  OutboxEvent[]
  plugins       CompanyPlugin[]
  pluginData    PluginData[]

  @@map("company")
}

/// Business rule: a user belongs to exactly ONE company (any role) — enforced by the unique userId.
model Membership {
  id        String           @id @default(cuid())
  userId    String           @unique
  companyId String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("membership")
}

model Invitation {
  id         String    @id @default(cuid())
  companyId  String
  email      String
  /// CompanyRole ids given on acceptance (one or more).
  roleIds    Json
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("invitation")
}

/// Company roles. Built-in roles are global rows (companyId null, key OWNER/ACCOUNTANT/STAFF) whose
/// permissions live in code (src/lib/permissions.ts); custom roles belong to one company and store theirs.
model CompanyRole {
  id          String           @id @db.VarChar(64)
  companyId   String?
  key         String?          @db.VarChar(20)
  name        String           @db.VarChar(60)
  description String?          @db.VarChar(200)
  permissions Json?
  createdAt   DateTime         @default(now())
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members     MembershipRole[]

  @@unique([companyId, name])
  @@map("company_role")
}

/// A member can hold several roles; effective permissions are the union.
model MembershipRole {
  membershipId String
  roleId       String      @db.VarChar(64)
  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_role")
}

/// Admin-panel roles. Built-in (key SUPER_ADMIN/SUPPORT/VIEWER) permissions live in code (src/lib/admin.ts).
model PlatformRole {
  id          String                   @id @db.VarChar(64)
  key         String?                  @unique @db.VarChar(20)
  name        String                   @unique @db.VarChar(60)
  description String?                  @db.VarChar(200)
  permissions Json?
  createdAt   DateTime                 @default(now())
  users       PlatformRoleAssignment[]

  @@map("platform_role")
}

model PlatformRoleAssignment {
  userId    String
  roleId    String       @db.VarChar(64)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("platform_role_assignment")
}

/// What platform admins did (company actions are in audit_log).
model PlatformAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String   @db.VarChar(191)
  action     String   @db.VarChar(60)
  targetType String   @db.VarChar(30)
  targetId   String?  @db.VarChar(191)
  data       Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("platform_audit_log")
}

/// Small key-value store for platform state (e.g. cron last tick).
model SystemState {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_state")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("audit_log")
}

// ───────────────────────── Masters ─────────────────────────

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Party {
  id              String    @id @default(cuid())
  companyId       String
  type            PartyType @default(CUSTOMER)
  name            String
  gstin           String    @default("")
  phone           String    @default("")
  email           String    @default("")
  billingAddress  String    @default("") @db.VarChar(500)
  shippingAddress String    @default("") @db.VarChar(500)
  stateCode       String    @db.Char(2)
  shippingState   String?   @db.Char(2)
  openingBalance  Decimal   @default(0) @db.Decimal(14, 2) // +ve = they owe us, -ve = we owe them
  creditDays      Int       @default(0)
  /// Reference from another suite service, e.g. "lead:<id>" (set by /api/v1/parties/upsert).
  externalRef     String?   @db.VarChar(100)
  /// Values added by plugins ({ "<plugin>.<field>": value }), shown on the party page.
  customFields    Json?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  documents Document[]
  purchases PurchaseBill[]
  payments  Payment[]

  @@index([companyId, name])
  @@index([companyId, externalRef])
  @@map("party")
}

model Product {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  hsnSac        String   @default("")
  isService     Boolean  @default(false)
  unit          String   @default("NOS")
  salePrice     Decimal  @default(0) @db.Decimal(14, 2)
  purchasePrice Decimal  @default(0) @db.Decimal(14, 2)
  gstRate       Decimal  @default(18) @db.Decimal(5, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, name])
  @@map("product")
}

enum DocType {
  INVOICE
  QUOTATION
  CREDIT_NOTE
  DEBIT_NOTE
}

model NumberSeries {
  id        String  @id @default(cuid())
  companyId String
  docType   DocType
  fy        String  @db.VarChar(5) // "26-27"
  prefix    String  @db.VarChar(6)
  nextSeq   Int     @default(1)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, docType, fy])
  @@map("number_series")
}

// ───────────────────────── Sales documents ─────────────────────────

enum DocStatus {
  ISSUED
  CANCELLED
  OPEN // quotation
  ACCEPTED // quotation
  CONVERTED // quotation -> invoice
  EXPIRED // quotation
}

model Document {
  id               String    @id @default(cuid())
  companyId        String
  type             DocType
  number           String    @db.VarChar(16)
  fy               String    @db.VarChar(5)
  seq              Int
  date             DateTime  @db.Date
  dueDate          DateTime? @db.Date
  status           DocStatus
  partyId          String
  partyName        String
  partyGstin       String    @default("")
  partyAddress     String    @default("") @db.VarChar(500)
  partyState       String    @db.Char(2)
  shippingAddress  String    @default("") @db.VarChar(500)
  seller           Json
  placeOfSupply    String    @db.Char(2)
  isInterstate     Boolean
  reverseCharge    Boolean   @default(false)
  pricesIncludeTax Boolean   @default(false)
  taxableTotal     Decimal   @db.Decimal(14, 2)
  cgst             Decimal   @db.Decimal(14, 2)
  sgst             Decimal   @db.Decimal(14, 2)
  igst             Decimal   @db.Decimal(14, 2)
  roundOff         Decimal   @db.Decimal(6, 2)
  grandTotal       Decimal   @db.Decimal(14, 2)
  originalDocId    String? // credit/debit note -> invoice
  convertedToId    String? // quotation -> invoice
  noteReason       String    @default("")
  /// Lead Manager lead id (leadRef) — set on API-created quotations and carried to the converted invoice.
  externalRef      String?   @db.VarChar(100)
  /// Values added by plugins ({ "<plugin>.<field>": { label, value, onPdf } }), shown on the document and PDF.
  customFields     Json?
  notes            String?   @db.Text
  createdById      String
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party       Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  originalDoc Document?           @relation("NoteOf", fields: [originalDocId], references: [id], onDelete: Restrict)
  notesOnThis Document[]          @relation("NoteOf")
  items       DocumentItem[]
  allocations PaymentAllocation[]

  @@unique([companyId, type, fy, seq])
  @@unique([companyId, type, number])
  @@index([companyId, type, date])
  @@index([companyId, externalRef])
  @@index([partyId])
  @@map("document")
}

model DocumentItem {
  id          String   @id @default(cuid())
  documentId  String
  position    Int
  productId   String?
  description String
  hsnSac      String   @default("")
  unit        String   @default("NOS")
  qty         Decimal  @db.Decimal(14, 3)
  rate        Decimal  @db.Decimal(14, 4)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  gstRate     Decimal  @db.Decimal(5, 2)
  taxable     Decimal  @db.Decimal(14, 2)
  cgst        Decimal  @db.Decimal(14, 2)
  sgst        Decimal  @db.Decimal(14, 2)
  igst        Decimal  @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_item")
}

// ───────────────────────── Purchases ─────────────────────────

enum ItcType {
  ELIGIBLE
  INELIGIBLE
  CAPITAL_GOODS
}

model PurchaseBill {
  id               String    @id @default(cuid())
  companyId        String
  billNumber       String
  billDate         DateTime  @db.Date
  dueDate          DateTime? @db.Date
  partyId          String
  partyName        String
  partyGstin       String    @default("")
  partyState       String    @db.Char(2)
  placeOfSupply    String    @db.Char(2)
  isInterstate     Boolean
  reverseCharge    Boolean   @default(false)
  itcType          ItcType   @default(ELIGIBLE)
  pricesIncludeTax Boolean   @default(false)
  taxableTotal     Decimal   @db.Decimal(14, 2)
  cgst             Decimal   @db.Decimal(14, 2)
  sgst             Decimal   @db.Decimal(14, 2)
  igst             Decimal   @db.Decimal(14, 2)
  roundOff         Decimal   @db.Decimal(6, 2)
  grandTotal       Decimal   @db.Decimal(14, 2)
  notes            String?   @db.Text
  cancelled        Boolean   @default(false)
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party       Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  items       PurchaseItem[]
  allocations PaymentAllocation[]

  @@unique([companyId, partyId, billNumber])
  @@index([companyId, billDate])
  @@map("purchase_bill")
}

model PurchaseItem {
  id          String       @id @default(cuid())
  billId      String
  position    Int
  productId   String?
  description String
  hsnSac      String       @default("")
  unit        String       @default("NOS")
  qty         Decimal      @db.Decimal(14, 3)
  rate        Decimal      @db.Decimal(14, 4)
  discountPct Decimal      @default(0) @db.Decimal(5, 2)
  gstRate     Decimal      @db.Decimal(5, 2)
  taxable     Decimal      @db.Decimal(14, 2)
  cgst        Decimal      @db.Decimal(14, 2)
  sgst        Decimal      @db.Decimal(14, 2)
  igst        Decimal      @db.Decimal(14, 2)
  total       Decimal      @db.Decimal(14, 2)
  bill        PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("purchase_item")
}

// ───────────────────────── Payments ─────────────────────────

enum PaymentDirection {
  RECEIVED
  PAID
}

enum PaymentMode {
  CASH
  UPI
  BANK
  CHEQUE
  CARD
  OTHER
}

model Payment {
  id          String           @id @default(cuid())
  companyId   String
  partyId     String
  direction   PaymentDirection
  date        DateTime         @db.Date
  amount      Decimal          @db.Decimal(14, 2)
  mode        PaymentMode      @default(BANK)
  reference   String           @default("")
  notes       String?          @db.Text
  createdById String
  createdAt   DateTime         @default(now())

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party       Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@index([companyId, date])
  @@index([partyId])
  @@map("payment")
}

model PaymentAllocation {
  id             String        @id @default(cuid())
  paymentId      String
  documentId     String?
  purchaseBillId String?
  amount         Decimal       @db.Decimal(14, 2)
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  purchaseBill   PurchaseBill? @relation(fields: [purchaseBillId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([documentId])
  @@index([purchaseBillId])
  @@map("payment_allocation")
}

// ───────────────────────── Backups ─────────────────────────

enum BackupScope {
  PLATFORM // whole database, controlled by a super-admin
  COMPANY // one company's data, controlled by its owner
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// A connected backup destination (currently Google Drive).
model BackupTarget {
  id              String      @id @default(cuid())
  /// "platform" or "company:<companyId>" — one target per scope.
  scopeKey        String      @unique
  scope           BackupScope
  companyId       String?
  provider        String      @default("GOOGLE_DRIVE")
  accountEmail    String
  /// OAuth refresh token, AES-256-GCM encrypted (see lib/backup/crypto.ts).
  refreshTokenEnc String      @db.Text
  folderId        String
  enabled         Boolean     @default(true)
  retentionDays   Int         @default(30)
  connectedById   String
  /// Set while a run is in progress (prevents overlapping runs).
  runningSince    DateTime?
  lastSuccessAt   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  company         Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs            BackupRun[]

  @@index([companyId])
  @@map("backup_target")
}

model BackupRun {
  id         String       @id @default(cuid())
  targetId   String
  trigger    String // SCHEDULED | MANUAL
  status     BackupStatus
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  fileName   String?
  fileId     String?
  sizeBytes  Int?
  deleted    Int          @default(0) // old files removed by retention in this run
  error      String?      @db.Text
  target     BackupTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, startedAt])
  @@map("backup_run")
}

// ───────────────────────── Suite integration (API + events) ─────────────────────────

/// Per-company API key for /api/v1. Only a SHA-256 hash is stored; the key is shown once.
model ApiKey {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  /// First characters of the key (e.g. "mgk_AbCd1234") so owners can tell keys apart.
  prefix      String    @db.VarChar(20)
  keyHash     String    @unique @db.Char(64)
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  /// Set for keys issued to an external plugin; those keys only get `scopes`.
  pluginId    String?   @db.VarChar(64)
  /// null = full access (keys created by owners). Plugin keys: ["documents:read", …].
  scopes      Json?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("api_key")
}

/// Stored first response for (company, Idempotency-Key, route) — replayed for 24 h.
model IdempotencyRecord {
  id        String   @id @default(cuid())
  companyId String
  key       String   @db.VarChar(200)
  route     String   @db.VarChar(100)
  status    Int
  response  Json
  createdAt DateTime @default(now())

  @@unique([companyId, key, route])
  @@index([createdAt])
  @@map("idempotency_record")
}

/// Outgoing webhook to Lead Manager (point-to-point until the Hub event router exists).
model CompanyIntegration {
  id               String   @id @default(cuid())
  companyId        String   @unique
  leadsWebhookUrl  String   @default("") @db.VarChar(500)
  /// HMAC signing secret, AES-GCM encrypted (lib/backup/crypto.ts).
  webhookSecretEnc String   @db.Text
  enabled          Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_integration")
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  DEAD
}

/// Transactional outbox: written in the same transaction as the business change, delivered by /api/cron/tick.
model OutboxEvent {
  id            String       @id // "evt_<hex>" — also the envelope id
  companyId     String
  type          String       @db.VarChar(60)
  envelope      Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now())
  sentAt        DateTime?
  /// null = the company's Lead Manager webhook; otherwise the plugin that receives this event.
  pluginId      String?      @db.VarChar(64)
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([companyId, createdAt])
  @@map("outbox_event")
}


// ───────────────────────── Plugins ─────────────────────────

enum PluginKind {
  CODE
  EXTERNAL
  UPLOADED
}

enum PluginStatus {
  NOT_INSTALLED
  INSTALLED
  /// A code plugin whose folder was removed from the repo.
  MISSING
}

enum PluginAvailability {
  /// Every company except blocked ones.
  ALL
  /// Only companies with CompanyPlugin.allowed = true.
  SELECTED
  /// Kill switch: nobody.
  NONE
}

/// A plugin known to this installation (code plugins are synced from src/plugins; external ones installed by URL).
model Plugin {
  id             String             @id @db.VarChar(64)
  kind           PluginKind
  name           String
  version        String             @db.VarChar(40)
  manifest       Json
  manifestUrl    String?            @db.VarChar(1000)
  /// UPLOADED: the packed CommonJS bundle (trusted code, see docs/plugins).
  bundle         String?            @db.LongText
  bundleSha256   String?            @db.VarChar(64)
  uploadedBy     String?
  status         PluginStatus       @default(NOT_INSTALLED)
  availability   PluginAvailability @default(NONE)
  /// On for each allowed company until its owner turns it off.
  defaultEnabled Boolean            @default(false)
  installedAt    DateTime?
  installedBy    String?
  lastError      String?            @db.VarChar(500)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  companies CompanyPlugin[]
  data      PluginData[]
  logs      PluginLog[]

  @@map("plugin")
}

/// A plugin's state for one company: super-admin allow/block + owner on/off + settings.
model CompanyPlugin {
  id                  String    @id @default(cuid())
  companyId           String
  pluginId            String    @db.VarChar(64)
  /// SELECTED availability: the super admin allowed this company.
  allowed             Boolean   @default(false)
  /// ALL availability: the super admin excluded this company.
  blocked             Boolean   @default(false)
  /// Owner's choice; null = follow Plugin.defaultEnabled.
  enabled             Boolean?
  /// Plugin settings (secret fields AES-encrypted as { enc: "..." }).
  settings            Json?
  acceptedPermissions Json?
  /// Auto-paused after repeated failures; the owner re-enables it.
  pausedReason        String?   @db.VarChar(300)
  failureCount        Int       @default(0)
  /// External plugins: secret their events are signed with (AES-encrypted) and the API key issued to them.
  webhookSecretEnc    String?   @db.Text
  apiKeyId            String?
  enabledAt           DateTime?
  enabledBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plugin              Plugin    @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([companyId, pluginId])
  @@index([pluginId])
  @@map("company_plugin")
}

/// Key-value storage for plugins, isolated per plugin and company.
model PluginData {
  id        String   @id @default(cuid())
  pluginId  String   @db.VarChar(64)
  companyId String
  key       String   @db.VarChar(191)
  value     Json
  updatedAt DateTime @updatedAt
  plugin    Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([pluginId, companyId, key])
  @@index([companyId])
  @@map("plugin_data")
}

model PluginLog {
  id        String   @id @default(cuid())
  pluginId  String   @db.VarChar(64)
  companyId String?
  level     String   @db.VarChar(10)
  message   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  plugin    Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([pluginId, createdAt])
  @@index([createdAt])
  @@map("plugin_log")
}
